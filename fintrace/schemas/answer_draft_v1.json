{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "claims", "limitations"],
  "properties": {
    "status": {"type": "string", "enum": ["answered", "unable_to_verify"]},
    "claims": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "company", "period", "basis", "unit", "evidence"],
        "properties": {
          "text": {"type": "string", "maxLength": 1000},
          "company": {"type": "string", "enum": ["CBA", "NAB"]},
          "period": {"type": "string", "maxLength": 120},
          "basis": {"type": "string", "maxLength": 180},
          "unit": {"type": "string", "maxLength": 80},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "quote"],
              "properties": {
                "source_id": {"type": "string"},
                "quote": {"type": "string", "maxLength": 2500}
              }
            }
          }
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 6, "items": {"type": "string", "enum": ["missing_evidence", "ambiguous_basis", "calculation_required", "partial_answer", "period_unavailable"]}}
  }
}
